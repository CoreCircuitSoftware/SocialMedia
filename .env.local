# .env.local
# Configuration for LOCAL development with Docker MySQL

# ==========================================
# Environment Mode
# ==========================================
ENVIRONMENT=local

# ==========================================
# Database Configuration - Local Docker MySQL
# ==========================================
DATABASE_HOST=db                        # Docker service name
DATABASE_NAME=circuitsocial-db
DATABASE_USER=django_user
DATABASE_PASSWORD=django_password
DATABASE_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword

# MySQL Root Password (for Docker container)
MYSQL_ROOT_PASSWORD=rootpassword

# ==========================================
# Django Settings
# ==========================================
DEBUG=1
SECRET_KEY="django-insecure-^2@x*gq%d9em7xjz#pc^=%*pkl7t_dut_$-i7_1cb91ni^1o_x"

# Allowed hosts for local development
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ==========================================
# Frontend Settings
# ==========================================
VITE_API_URL=http://localhost:8000

# ==========================================
# Optional: Django Settings
# ==========================================
# DJANGO_SETTINGS_MODULE=backend.settings
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
