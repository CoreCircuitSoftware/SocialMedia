# .env.production
# Configuration for PRODUCTION on EC2 with AWS RDS

# ==========================================
# Environment Mode
# ==========================================
ENVIRONMENT=production

# ==========================================
# Database Configuration - AWS RDS
# ==========================================
DATABASE_HOST=CHANGE-THIS_rds-instance.xxxxxx.us-east-1.rds.amazonaws.com
DATABASE_NAME=circuitsocial-db
DATABASE_USER=admin
DATABASE_PASSWORD=CHANGE-THIS
DATABASE_PORT=3306

# ==========================================
# Django Settings
# ==========================================
DEBUG=0

# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=

# Comma-separated list (no spaces!)
ALLOWED_HOSTS=ec2-ip,domain.com,www.domain.com

# ==========================================
# Frontend Settings
# ==========================================
VITE_API_URL=https://domain.com

# ==========================================
# Security Settings
# ==========================================
CSRF_TRUSTED_ORIGINS=https://domain.com,https://www.domain.com

# ==========================================
# AWS S3 for Media Storage
# ==========================================
USE_S3=True
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_STORAGE_BUCKET_NAME=circuitsocial-s3
AWS_S3_REGION_NAME=us-east-2