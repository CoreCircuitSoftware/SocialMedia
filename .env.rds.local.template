# .env.rds.local
# Configuration for LOCAL development connected to AWS RDS
# Use this when you want to test against real RDS database from your computer

# ==========================================
# Environment Mode
# ==========================================
ENVIRONMENT=rds-local

# ==========================================
# Database Configuration - AWS RDS
# ==========================================
# IMPORTANT: Make sure IP is allowed in RDS security group!

DATABASE_HOST=CHANGE-THIS_rds-instance.xxxxxx.us-east-1.rds.amazonaws.com
DATABASE_NAME=circuitsocial-db
DATABASE_USER=admin
DATABASE_PASSWORD=CHANGE-THIS
DATABASE_PORT=3306

# ==========================================
# Django Settings
# ==========================================
DEBUG=1
SECRET_KEY="django-insecure-^2@x*gq%d9em7xjz#pc^=%*pkl7t_dut_$-i7_1cb91ni^1o_x"

# Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ==========================================
# Frontend Settings
# ==========================================
VITE_API_URL=http://localhost:8000

# ==========================================
# Notes
# ==========================================
# Before using this:
# 1. Add public IP to RDS security group (port 3306)
# 2. Get IP: curl ifconfig.me
# 3. AWS Console → RDS → Security Groups → Edit Inbound Rules
# 4. Add rule: MySQL, Port 3306, Source: [IP]/32
